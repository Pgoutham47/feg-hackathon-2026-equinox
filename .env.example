# ─── shared ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | staging | production

# ─── apps/web (Next.js) ───────────────────────────────────────────────────────
# Server-side only: the API origin the RSC layer talks to.
API_BASE_URL=http://localhost:8000
# Public: browser-visible API origin (same value in dev, edge/CDN host in prod).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Public: the SAME-ORIGIN path the browser sees game bundles at. Must stay a
# path, never another host: a service worker cannot control a cross-origin
# iframe, so a bundle on its own domain is one the worker never sees and the
# prefetch buys nothing.
NEXT_PUBLIC_CDN_BASE_URL=/cdn
# Server-side only: where /cdn/* is rewritten to. Object storage in production,
# the API's dev CDN locally. The browser is never handed this value.
CDN_UPSTREAM_URL=http://localhost:8000/cdn
# Public: kill switch. When false the SW registers but prefetches nothing.
NEXT_PUBLIC_PREFETCH_ENABLED=true
# Public: per-device prefetch budget in bytes (default 6.5 MB = the Play-screen slice).
NEXT_PUBLIC_PREFETCH_BUDGET_BYTES=6815744

# ─── apps/api (FastAPI) ───────────────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string → URI (session pooler).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/empireofgold
# Direct (non-pooled) connection — Alembic only. Supabase port 5432, not 6543.
DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:postgres@localhost:5432/empireofgold
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

CORS_ORIGINS=http://localhost:3000
# Prefix every manifest URL is built from. A path, so URLs resolve against the
# lobby's own origin — the only origin its service worker can serve from.
CDN_BASE_URL=/cdn
# Dev only: where `skin-baker publish --backend local` wrote its objects.
DEV_CDN_ROOT=cdn
# Shared secret for /internal/* job endpoints (cron → API). Rotate per environment.
INTERNAL_API_KEY=change-me-openssl-rand-hex-32
LOG_LEVEL=INFO
LOG_FORMAT=console                 # console | json  (json in staging/production)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── tools/skin-baker ─────────────────────────────────────────────────────────
SOURCE_BUNDLE_DIR=./vendor/empireofgold
STORAGE_BUCKET=game-bundles
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=         # server-only, never ships to the browser
